          "http": {
            "method": "POST",
            "url": "https://iot.{region}.amazonaws.com/tags/:resourceArn",
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": "The ARN of the resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds to or modifies the tags of the given resource."
